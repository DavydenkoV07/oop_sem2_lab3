<Window x:Class="WordAnalyzer.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аналізатор частоти слів (Lab 3)" Height="450" Width="500" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Вибір файлів -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <Button Name="BtnSelectFiles" Content="1. Обрати текстові файли (.txt)" Padding="8" Click="BtnSelectFiles_Click"/>
            <TextBlock Name="TxtSelectedFiles" Text="Файли не обрано" Margin="0,5,0,0" Foreground="DarkGray" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Вибір режиму (Патерн Strategy в дії) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="2. Оберіть режим обробки:" FontWeight="Bold" Margin="0,0,0,5"/>
            <RadioButton Name="RbSequential" Content="Послідовно (1 потік)" IsChecked="True" Margin="0,2"/>
            <RadioButton Name="RbParallel" Content="Паралельно (Мультипотік)" Margin="0,2"/>
        </StackPanel>

        <!-- Кнопка Старт -->
        <Button Grid.Row="2" Name="BtnStart" Content="3. СТАРТ" Padding="10" FontWeight="Bold" Background="#FF0078D7" Foreground="White" Click="BtnStart_Click"/>

        <!-- Результат часу -->
        <TextBlock Grid.Row="3" Name="TxtTime" Text="Час виконання: 0 мс" Margin="0,15,0,5" FontWeight="Bold" FontSize="14" Foreground="#FF107C10"/>

        <!-- Лог результатів -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="Топ 20 найчастіших слів:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox Name="TxtResults" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Height="170" FontFamily="Consolas"/>
        </StackPanel>
    </Grid>
</Window>
